{
  "kind": "sanitized-source-security-evidence-publication",
  "sourceCommit": "7bd3575fff351fd4f1b20c694619457ded99a1a6",
  "originals": "Private immutable evidence retains original bytes; embedded command/log hashes refer to those originals. This manifest binds each sanitized public derivative. No outcomes, counts or findings are changed.",
  "pathRules": [
    {
      "id": 1,
      "pattern": "/Users/[^/]+/\\.codex/worktrees/p15s/hostwright",
      "replacement": "/SOURCE"
    },
    {
      "id": 2,
      "pattern": "/Users/[^/]+/\\.codex/qualification/phase15-ga/issue272-final",
      "replacement": "/EVIDENCE"
    },
    {
      "id": 3,
      "pattern": "/Users/[^/]+/\\.codex/qualification/phase15-homebrew-01a11c01/rc7-preparation/independent-security-review",
      "replacement": "/REVIEW"
    },
    {
      "id": 4,
      "pattern": "/Users/[^/]+/\\.codex/worktrees",
      "replacement": "/WORKTREES"
    },
    {
      "id": 5,
      "pattern": "/Users/[^/]+/\\.codex/qualification",
      "replacement": "/QUALIFICATION"
    },
    {
      "id": 6,
      "pattern": "/Users/[^/]+",
      "replacement": "/HOME"
    },
    {
      "id": 7,
      "pattern": "/(?:private/)?var/folders/[^/]+/[^/]+/T",
      "replacement": "/TMP"
    },
    {
      "id": 8,
      "pattern": "/private/tmp(?=/)",
      "replacement": "/TMP"
    },
    {
      "id": 9,
      "pattern": "/tmp(?=/)",
      "replacement": "/TMP"
    }
  ],
  "notes": [
    "Temporary-directory aliases are normalized; test-owned scratch basenames remain for scoped cleanup correlation.",
    "Sanitized wrappers show the executed recipe; substitute local paths before reproducing.",
    "Two console logs additionally remove trailing horizontal whitespace for repository formatting; per-file pathSanitizedSHA256 retains the intermediate content hash. Outcomes, counts, findings and line order are unchanged."
  ],
