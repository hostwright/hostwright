less_than_thirtytwo:
	/* copy the last 0 to 31 bytes of the source */
	rsb     r12, lr, #32            /* we corrupted r12, recompute it  */
	add     r2, r2, #32
	cmp     r2, #4
	blo     partial_word_tail

1:      ldr     r5, [r1], #4
	sub     r2, r2, #4
#if __ARMEB__
	mov     r4, r5,                 lsr lr
	orr     r4, r4, r3
	mov     r3,     r5,                     lsl r12
#else
	mov     r4, r5,                 lsl lr
	orr     r4, r4, r3
	mov     r3,     r5,                     lsr r12
#endif
	str     r4, [r0], #4
	cmp     r2, #4
	bhs     1b

partial_word_tail:
	/* we have a partial word in the input buffer */
	movs    r5, lr, lsl #(31-3)
#if __ARMEB__
	movmi   r3, r3, ror #24
	strbmi r3, [r0], #1
	movcs   r3, r3, ror #24
	strbcs r3, [r0], #1
	movcs   r3, r3, ror #24
	strbcs r3, [r0], #1
#else
	strbmi r3, [r0], #1
	movmi   r3, r3, lsr #8
	strbcs r3, [r0], #1
	movcs   r3, r3, lsr #8
	strbcs r3, [r0], #1
#endif

