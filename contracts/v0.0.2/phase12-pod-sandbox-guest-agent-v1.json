{
  "contract": "hostwright-pod-sandbox-guest-agent",
  "protocolVersion": 1,
  "status": "portable-boundary-implemented",
  "framing": {
    "transport": "connected-byte-stream",
    "lengthPrefixBytes": 4,
    "lengthEncoding": "unsigned-big-endian",
    "zeroLength": "reject",
    "requestPayloadBytes": {
      "maximum": 65536
    },
    "responseOrFramePayloadBytes": {
      "maximum": 1048576
    }
  },
  "encoding": {
    "mediaType": "application/json",
    "canonical": {
      "sortedKeys": true,
      "withoutEscapingSlashes": true
    },
    "reject": [
      "malformed-json",
      "duplicate-field",
      "unknown-field",
      "missing-field",
      "non-canonical-json",
      "unsupported-version"
    ]
  },
  "authentication": {
    "requiredBeforeDispatch": true,
    "boundary": "GuestAgentAuthenticationBoundary",
    "portableExecutableBoundary": "unavailable-fail-closed",
    "unauthenticatedLifecycleMutation": "reject"
  },
  "limits": {
    "deadlineMilliseconds": {
      "minimum": 1,
      "maximum": 30000
    },
    "requestIDBytes": 128,
    "ownerIDBytes": 128,
    "credit": 64,
    "capabilities": 16,
    "errorBytes": 512
  },
  "creditSemantics": {
    "scope": "sandbox-session",
    "firstLifecycleRequest": "must-grant-positive-credit",
    "replenishment": "request-credit-is-an-additional-grant",
    "acceptedRequestCost": 1,
    "response": "remaining-credit",
    "teardown": "clear-window",
    "cancelControl": "does-not-consume-credit"
  },
  "envelope": {
    "required": [
      "apiVersion",
      "kind",
      "requestID",
      "operation",
      "sandboxID",
      "ownerID",
      "generation",
      "deadlineMilliseconds",
      "credit",
      "capabilities"
    ],
    "optional": [
      "cancellationOfRequestID",
      "cpuCount",
      "memoryMiB",
      "state",
      "result",
      "error"
    ],
    "requestCreateFields": [
      "cpuCount",
      "memoryMiB"
    ],
    "responseResultFields": [
      "state",
      "result"
    ],
    "responseErrorField": "error",
    "cancelSemantics": {
      "withCancellationOfRequestID": "cancel-control",
      "withoutCancellationOfRequestID": "lifecycle-cancel"
    }
  },
  "capabilities": [
    "pod-sandbox-lifecycle",
    "restart-recovery",
    "cancellation",
    "stream-credit",
    "strict-framing"
  ],
  "errors": [
    "malformed",
    "unsupportedVersion",
    "unauthenticated",
    "invalidTransition",
    "ownershipMismatch",
    "generationMismatch",
    "generationConflict",
    "replayMismatch",
    "deadlineExceeded",
    "cancelled",
    "creditExhausted",
    "sandboxNotFound",
    "recoveryPersistenceFailed",
    "cleanupIncomplete",
    "internalFailure"
  ],
  "states": [
    "absent",
    "created",
    "prepared",
    "running",
    "stopped",
    "recovering",
    "cancelling",
    "tearingDown"
  ],
  "transitions": {
    "create": {
      "from": [
        "absent"
      ],
      "to": "created",
      "generationFence": "strictly-newer-than-tombstone"
    },
    "prepare": {
      "from": [
        "created",
        "stopped",
        "prepared"
      ],
      "to": "prepared"
    },
    "start": {
      "from": [
        "prepared",
        "stopped",
        "running"
      ],
      "to": "running"
    },
    "stop": {
      "from": [
        "running",
        "stopped"
      ],
      "to": "stopped"
    },
    "restart": {
      "from": [
        "prepared",
        "stopped",
        "running"
      ],
      "to": "running"
    },
    "recover": {
      "from": [
        "recovering",
        "created",
        "prepared",
        "running",
        "stopped"
      ],
      "to": "known-state-or-absent-after-cleanup"
    },
    "cancel": {
      "from": [
        "created",
        "prepared",
        "running",
        "stopped",
        "recovering",
        "cancelling"
      ],
      "to": "absent",
      "cleanup": "exact-owned-resources"
    },
    "teardown": {
      "from": [
        "created",
        "prepared",
        "running",
        "stopped",
        "recovering",
        "cancelling",
        "tearingDown"
      ],
      "to": "absent",
      "cleanup": "exact-owned-resources"
    }
  },
  "recoveryJournal": {
    "schemaVersion": 1,
    "storage": "caller-supplied-PodSandboxRecoveryStore",
    "fileStoreMaximumBytes": 1048576,
    "recordsMaximum": 1024,
    "tombstonesMaximum": 1024,
    "replaysPerRecordMaximum": 4096,
    "fields": [
      "schemaVersion",
      "records",
      "tombstones"
    ],
    "persistence": "atomic-canonical-write-before-success",
    "failure": "rollback-transition-and-report-persistence-error"
  },
  "executable": {
    "stdio": "--stdio",
    "stdioWithRecovery": "--stdio --recovery-file <absolute-path>",
    "version": "--version",
    "invalidArguments": "reject-before-dispatch"
  },
  "deferred": [
    "apple-container-vm-runtime",
    "cri-adapter",
    "cni-adapter",
    "csi-adapter"
  ]
}
