{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostwright.dev/schemas/hostwright-yaml.schema.json",
  "title": "Hostwright Manifest v2",
  "description": "Strict, bounded Hostwright Manifest v2 workload contract.",
  "type": "object",
  "required": ["version", "project", "services"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "imagePolicy": {
            "const": "require-digest"
          }
        },
        "required": ["imagePolicy"]
      },
      "then": {
        "properties": {
          "services": {
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/$defs/service"
                },
                {
                  "properties": {
                    "image": {
                      "pattern": "^(?!-)(?!.*://)[^@\\s]+@sha256:[a-f0-9]{64}$"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["imageTrust"]
      },
      "then": {
        "properties": {
          "imagePolicy": {
            "const": "require-digest"
          }
        },
        "required": ["imagePolicy"]
      }
    },
    {
      "if": {
        "required": ["imageSBOM"]
      },
      "then": {
        "properties": {
          "imagePolicy": {
            "const": "require-digest"
          }
        },
        "required": ["imagePolicy"]
      }
    },
    {
      "if": {
        "required": ["imageVulnerability"]
      },
      "then": {
        "properties": {
          "imagePolicy": {
            "const": "require-digest"
          }
        },
        "required": ["imagePolicy", "imageTrust"]
      }
    },
    {
      "if": {
        "required": ["imageProvenance"]
      },
      "then": {
        "properties": {
          "imagePolicy": {
            "const": "require-digest"
          }
        },
        "required": ["imagePolicy"]
      }
    }
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "project": {
      "$ref": "#/$defs/name"
    },
    "imagePolicy": {
      "enum": ["allow-tags", "require-digest"]
    },
    "imageTrust": {
      "$ref": "#/$defs/imageTrust"
    },
    "imageSBOM": {
      "$ref": "#/$defs/imageSBOM"
    },
    "imageVulnerability": {
      "$ref": "#/$defs/imageVulnerability"
    },
    "imageProvenance": {
      "$ref": "#/$defs/imageProvenance"
    },
    "volumes": {
      "$ref": "#/$defs/volumeDeclarations"
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(B|KiB|MiB|GiB|TiB)$"
    },
    "duration": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)s$"
    },
    "normalizedAbsoluteHostPath": {
      "type": "string",
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$)).+$"
    },
    "safeAuthorityID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
    },
    "httpsURL": {
      "type": "string",
      "pattern": "^https://[^\\s?#]+(?:/[^\\s?#]*)?(?:\\?[^\\s#]*)?(?:#[^\\s]*)?$"
    },
    "rfc3339Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "provenanceURI": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^(?!.*@)(?!.*\\.\\.)(?:https://|urn:)[^\\s\\u0000-\\u001F\\u007F]+$"
    },
    "provenanceSignerID": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "boundedNormalizedAbsoluteHostPath": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^/(?!.*//)(?!.*(?:^|/)\\.\\.?(/|$))[^\\u0000-\\u001F\\u007F]+$"
    },
    "providerID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "labels": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "volumeDeclarations": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/volumeDeclaration"
      }
    },
    "volumeDeclaration": {
      "type": "object",
      "required": ["capacity"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerID",
          "default": "hostwright-local"
        },
        "capacity": {
          "$ref": "#/$defs/size"
        },
        "accessMode": {
          "enum": ["read-write-once", "read-only-many"],
          "default": "read-write-once"
        },
        "reclaimPolicy": {
          "enum": ["retain", "delete", "snapshot-before-delete", "backup-before-delete", "recycle"],
          "default": "retain"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "secretReference": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^keychain://[A-Za-z0-9._:@-]{1,128}/[A-Za-z0-9._:@-]{1,128}$"
        },
        {
          "pattern": "^env-file:///(?:#[A-Za-z_][A-Za-z0-9_]{0,127}|(?=[^#]{1,4095}#)(?!/)(?!\\.{1,2}(?:/|#))(?!.*//)(?!.*(?:/\\.\\.?)(?:/|#))[^#\\u0000-\\u001F]*[^/#\\u0000-\\u001F]#[A-Za-z_][A-Za-z0-9_]{0,127})$"
        },
        {
          "pattern": "^local-file:///(?:|(?!/)(?!\\.{1,2}(?:/|$))(?!.*//)(?!.*(?:/\\.\\.?)(?:/|$))(?=[^#]{1,4095}$)[^#\\u0000-\\u001F]*[^/#\\u0000-\\u001F])$"
        },
        {
          "pattern": "^external://[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9._:@-]{1,128}$"
        },
        {
          "pattern": "^plugin://[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9._:@-]{1,128}$"
        }
      ]
    },
    "imageTrust": {
      "type": "object",
      "required": ["threshold", "authorities"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "trustedRoot": {
          "$ref": "#/$defs/normalizedAbsoluteHostPath"
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/imageTrustAuthority"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authorities": {
                "contains": {
                  "properties": {
                    "type": {
                      "const": "keyless"
                    }
                  },
                  "required": ["type"]
                }
              }
            },
            "required": ["authorities"]
          },
          "then": {
            "required": ["trustedRoot"]
          }
        }
      ]
    },
    "imageTrustAuthority": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/safeAuthorityID"
        },
        "type": {
          "enum": ["keyed", "keyless"]
        },
        "publicKey": {
          "$ref": "#/$defs/normalizedAbsoluteHostPath"
        },
        "issuer": {
          "$ref": "#/$defs/httpsURL"
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "notBefore": {
          "$ref": "#/$defs/rfc3339Timestamp"
        },
        "notAfter": {
          "$ref": "#/$defs/rfc3339Timestamp"
        },
        "revokedAt": {
          "$ref": "#/$defs/rfc3339Timestamp"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "keyed"
            }
          },
          "required": ["publicKey"],
          "not": {
            "anyOf": [
              {
                "required": ["issuer"]
              },
              {
                "required": ["identity"]
              }
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "keyless"
            }
          },
          "required": ["issuer", "identity"],
          "not": {
            "required": ["publicKey"]
          }
        }
      ]
    },
    "imageSBOM": {
      "type": "object",
      "required": ["requirement", "formats"],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "requirement": {
          "enum": ["optional", "required"]
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["spdx-json", "cyclonedx-json"]
          }
        }
      }
    },
    "imageVulnerability": {
      "type": "object",
      "required": [
        "severityThreshold",
        "minimumVulnerabilityAgeSeconds",
        "exploitability",
        "fixAvailability",
        "maximumDatabaseAgeSeconds",
        "staleAction",
        "unavailableAction",
        "exceptionApproval"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "severityThreshold": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "minimumVulnerabilityAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "exploitability": {
          "enum": ["any", "known-exploited"]
        },
        "fixAvailability": {
          "enum": ["any", "fix-available"]
        },
        "maximumDatabaseAgeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "staleAction": {
          "enum": ["fail-open", "fail-closed"]
        },
        "unavailableAction": {
          "enum": ["fail-open", "fail-closed"]
        },
        "exceptionApproval": {
          "enum": ["required", "disabled"]
        },
        "allowlist": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/imageVulnerabilityAllowlistEntry"
          }
        }
      }
    },
    "imageVulnerabilityAllowlistEntry": {
      "type": "object",
      "required": ["vulnerabilityID", "reason", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "vulnerabilityID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "packagePURL": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^pkg:[^\\s\\u0000-\\u001F\\u007F/]+/[^\\s\\u0000-\\u001F\\u007F]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F](?:[^\\u0000-\\u001F\\u007F]*[^\\s\\u0000-\\u001F\\u007F])?$"
        },
        "expiresAt": {
          "$ref": "#/$defs/rfc3339Timestamp"
        }
      }
    },
    "imageProvenance": {
      "type": "object",
      "required": [
        "requirement",
        "builderIDs",
        "buildTypes",
        "signers",
        "maximumAgeSeconds",
        "requireReproducible"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "requirement": {
          "enum": ["optional", "required"]
        },
        "builderIDs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provenanceURI"
          }
        },
        "buildTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provenanceURI"
          }
        },
        "signers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/imageProvenanceSigner"
          }
        },
        "maximumAgeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31536000
        },
        "requireReproducible": {
          "type": "boolean"
        }
      }
    },
    "imageProvenanceSigner": {
      "type": "object",
      "required": ["id", "publicKey"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/provenanceSignerID"
        },
        "publicKey": {
          "$ref": "#/$defs/boundedNormalizedAbsoluteHostPath"
        },
        "notBefore": {
          "$ref": "#/$defs/rfc3339Timestamp"
        },
        "notAfter": {
          "$ref": "#/$defs/rfc3339Timestamp"
        },
        "revokedAt": {
          "$ref": "#/$defs/rfc3339Timestamp"
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!-)(?!.*://)(?:[^@\\s]+|[^@\\s]+@sha256:[a-f0-9]{64})$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256,
          "default": 1
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "user": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "group": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "workdir": {
          "type": "string",
          "pattern": "^/(?!.*(?:^|/)\\.\\.?/)(?!.*//).*$"
        },
        "entrypoint": {
          "$ref": "#/$defs/stringArray"
        },
        "command": {
          "$ref": "#/$defs/stringArray"
        },
        "init": {
          "type": "boolean",
          "default": false
        },
        "dependsOn": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "enum": ["started", "ready", "completed"]
          }
        },
        "env": {
          "$ref": "#/$defs/environment"
        },
        "secretEnv": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/secretReference"
          }
        },
        "labels": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "maxLength": 128,
            "pattern": "^(?!dev\\.hostwright\\.).+$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,5}:[0-9]{1,5}$"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(?!/+(?:\\./*)*:)(?![^:]*(?:^|/)\\.\\.(?:/|:)).+:/[^:]+(:ro|:rw)?$"
              },
              {
                "$ref": "#/$defs/mount"
              }
            ]
          }
        },
        "health": {
          "$ref": "#/$defs/health",
          "deprecated": true
        },
        "probes": {
          "$ref": "#/$defs/probes"
        },
        "restart": {
          "$ref": "#/$defs/restart"
        },
        "update": {
          "$ref": "#/$defs/update"
        },
        "hooks": {
          "$ref": "#/$defs/hooks"
        },
        "rosetta": {
          "type": "boolean",
          "default": false
        },
        "virtualization": {
          "type": "boolean",
          "default": false
        },
        "readOnlyRootFilesystem": {
          "type": "boolean",
          "default": false
        },
        "shmSize": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "const": "linux",
          "default": "linux"
        },
        "architecture": {
          "enum": ["arm64", "amd64"],
          "default": "arm64"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 16384
      }
    },
    "mount": {
      "oneOf": [
        {
          "$ref": "#/$defs/bindMount"
        },
        {
          "$ref": "#/$defs/volumeMount"
        },
        {
          "$ref": "#/$defs/tmpfsMount"
        }
      ]
    },
    "bindMount": {
      "type": "object",
      "required": ["type", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "bind"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/normalizedAbsoluteContainerPath"
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "volumeMount": {
      "type": "object",
      "required": ["type", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "volume"
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "target": {
          "$ref": "#/$defs/normalizedAbsoluteContainerPath"
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "tmpfsMount": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tmpfs"
        },
        "target": {
          "$ref": "#/$defs/normalizedAbsoluteContainerPath"
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "type": "string",
          "pattern": "^[0-7]{3,4}$"
        },
        "size": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "health": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/stringArray"
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        },
        "liveness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["exec"]
        },
        {
          "required": ["http"]
        },
        {
          "required": ["tcp"]
        }
      ],
      "properties": {
        "exec": {
          "$ref": "#/$defs/stringArray"
        },
        "http": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "tcp": {
          "type": "object",
          "required": ["port"],
          "additionalProperties": false,
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "startPeriod": {
          "$ref": "#/$defs/duration"
        },
        "interval": {
          "$ref": "#/$defs/duration"
        },
        "timeout": {
          "$ref": "#/$defs/duration"
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "restart": {
      "type": "object",
      "required": ["policy"],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "enum": ["no", "on-failure", "unless-stopped"]
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": ["rolling", "recreate"],
          "default": "rolling"
        },
        "maxSurge": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "progressDeadline": {
          "type": "string",
