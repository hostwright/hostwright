loop24:
	ldr     r12, [r1], #4
1:      mov     r4, r12
	ldmia   r1!, {   r5,r6,r7,  r8,r9,r10,r11}
	subs    r2, r2, #32
	ldrhs   r12, [r1], #4
#if __ARMEB__
	orr     r3, r3, r4, lsr #8
	mov     r4, r4, lsl #24
	orr     r4, r4, r5, lsr #8
	mov     r5, r5, lsl #24
	orr     r5, r5, r6, lsr #8
	mov     r6, r6, lsl #24
	orr     r6, r6, r7, lsr #8
	mov     r7, r7, lsl #24
	orr     r7, r7, r8, lsr #8
	mov     r8, r8, lsl #24
	orr     r8, r8, r9, lsr #8
	mov     r9, r9, lsl #24
	orr     r9, r9, r10, lsr #8
	mov     r10, r10, lsl #24
	orr     r10, r10, r11, lsr #8
	stmia   r0!, {r3,r4,r5,r6, r7,r8,r9,r10}
	mov     r3, r11, lsl #24
#else
	orr     r3, r3, r4, lsl #8
	mov     r4, r4, lsr #24
	orr     r4, r4, r5, lsl #8
	mov     r5, r5, lsr #24
	orr     r5, r5, r6, lsl #8
	mov     r6, r6, lsr #24
	orr     r6, r6, r7, lsl #8
	mov     r7, r7, lsr #24
	orr     r7, r7, r8, lsl #8
	mov     r8, r8, lsr #24
	orr     r8, r8, r9, lsl #8
	mov     r9, r9, lsr #24
	orr     r9, r9, r10, lsl #8
	mov     r10, r10, lsr #24
	orr     r10, r10, r11, lsl #8
	stmia   r0!, {r3,r4,r5,r6, r7,r8,r9,r10}
	mov     r3, r11, lsr #24
#endif
